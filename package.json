{
    "name": "joplin-plugin-wrapped-line-indent",
    "version": "1.2.1",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:browser": "vitest run --config vitest.browser.config.mts",
        "test:browser:watch": "vitest --config vitest.browser.config.mts --browser.headless=false",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.6.0",
        "@codemirror/commands": "6.10.3",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.14",
        "@fontsource/roboto": "^5.3.0",
        "@fontsource/roboto-mono": "^5.3.0",
        "@lezer/common": "1.5.2",
        "@types/node": "^24.19.2",
        "@vitest/browser-playwright": "^5.1.0",
        "fallow": "^3.43.0",
        "jsdom": "^31.0.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "playwright": "^1.65.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
