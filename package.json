{
    "name": "joplin-plugin-wrapped-line-indent",
    "version": "1.2.0",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "eslint src/ test/",
        "lint:fix": "eslint src/ test/ --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --passWithNoTests && node --test test/*.test.mjs",
        "test:watch": "vitest",
        "test:browser": "vitest run --config vitest.browser.config.mts",
        "test:browser:watch": "vitest --config vitest.browser.config.mts --browser.headless=false",
        "knip": "knip",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.5.0",
        "@codemirror/commands": "6.10.3",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.14",
        "@eslint/js": "^10.0.1",
        "@fontsource/roboto": "^5.3.0",
        "@fontsource/roboto-mono": "^5.3.0",
        "@lezer/common": "1.5.2",
        "@types/node": "^25.9.4",
        "@vitest/browser-playwright": "^5.1.0",
        "@vitest/eslint-plugin": "^1.6.28",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.7.0",
        "jsdom": "^30.1.3",
        "knip": "^6.44.1",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
}
